<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\RagChatDemo.IngestionWorker\RagChatDemo.IngestionWorker.csproj" />
    <ProjectReference Include="..\RagChatDemo.Shared\RagChatDemo.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>61b59970-84ee-4b27-98ba-91eb9d0e7c43</UserSecretsId>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Prevent IngestionWorker's appsettings from clashing during publish -->
    <None Remove="..\RagChatDemo.IngestionWorker\appsettings*.json" />
  </ItemGroup>

</Project>
